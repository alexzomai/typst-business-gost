#import "../src/export.typ": *
#show: business-doc.with(title: "Пример длинного двустороннего документа", duplex: true, long-retention: true)

#document-heading(
  "ДОГОВОР",
  number: "[номер]",
  subject: "длинный пример для проверки вёрстки",
  place: "[Место заключения]",
  date: "[Дата]",
)

#let sentence = [Стороны согласовали, что исполнение обязательств по настоящему разделу осуществляется в порядке, предусмотренном договором, с учётом согласованных сроков, объёма и порядка взаимодействия. ]

#for n in range(1, 7) [
  = Раздел примера #n
  #for k in range(1, 6) [
    #n.#k. #sentence #sentence #sentence
  ]
]

= Таблица расчётов
#data-table(
  (auto, 1fr, auto, auto),
  ([№], [Наименование], [Срок], [Сумма, руб.]),
  range(1, 57).map(i => ([#i], [Позиция примера #i с достаточно длинным наименованием для переноса строки в ячейке], [[срок]], [0,00])),
)

#v(1em)
#signatures(
  left: (position: [Исполнитель], name: "[Инициалы Фамилия]"),
  right: (position: [Заказчик], name: "[Инициалы Фамилия]"),
)
